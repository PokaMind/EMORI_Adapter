<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>emori_msgs</name>
  <version>0.1.0</version>
  <description>EMORI custom ROS 2 interfaces: Context (per-learner engagement/affect/context, a
  REP-155 extension), SpeechCue (one sentence of assistant speech + its cue family),
  SetExpression (the bounded expression skill topic) and the LookAt / ReplayMotion skill
  actions the engagement node sends to skill_facade. Also the hub's session, speech,
  gesture, motion, add-on and gateway interfaces.</description>
  <maintainer email="dev@pokamind.com">Pokamind AB</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/pokamind/EMORI_Adapter</url>
  <url type="bugtracker">https://github.com/pokamind/EMORI_Adapter/issues</url>
  <author email="dev@pokamind.com">Pokamind AB</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <!-- SpeechCue.source_time (correlation against the upstream envelope's own clock) -->
  <depend>builtin_interfaces</depend>
  <!-- LookAt.action / ReplayMotion.action: rosidl needs action_msgs to generate them -->
  <depend>action_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

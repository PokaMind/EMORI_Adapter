# Copy to .env and adjust. Never commit the real .env.
# Loaded by emori_adapter.config (python-dotenv) on EVERY entry point, incl. the hostapp.
# Each section links to its full notes in docs/configuration.md (same headings, same order).
# An EMPTY value means "not set here": the robot then takes, in order, what its admin page
# saved, this file, its Pokamind record (course, languages, pathways, name), its
# hardware profile, the code default. Admin-page values outrank this file. Where each value
# came from: docs/configuration.md "Where each setting comes from".

# ============ Journal verbosity (the deployed services) ============
# Details: docs/configuration.md#journal-verbosity-the-deployed-services
# Root log level for emori-hostapp AND emori-admin: DEBUG | INFO (default) | WARNING | ERROR.
# INFO is the operating level; below WARNING only EMORI's own loggers reach the journal.
#EMORI_LOG_LEVEL=INFO
# =1 lets third-party wire logs through (full URLs, tokens, frame contents, query strings).
# NEVER on a deployed robot: journald is world-readable and survives reboots. Dev triage only.
#EMORI_LOG_WIRE=0

# ============ Reachy Mini daemon ============
# Details: docs/configuration.md#reachy-mini-daemon
# Windows dev sim and the CM4: http://127.0.0.1:8000 (or localhost);
# from the ROS 2 container: http://host.docker.internal:8000.
REACHY_BASE_URL=http://127.0.0.1:8000
REACHY_TIMEOUT_S=5.0

# ============ Identity defaults (used when no session is active) ============
# Details: docs/configuration.md#identity-defaults-used-when-no-session-is-active
EMORI_PERSON_ID=learner_01
EMORI_SESSION_ID=sim-session
EMORI_CYCLE_PERIOD_S=2.0

# ============ THIS robot's own Pokamind account (unique per robot) ============
# Details: docs/configuration.md#this-robots-own-pokamind-account-unique-per-robot
# The robot's own learner is robot-<id>@emori.local, <id> = its token's robot id. PRODUCTION:
# it exists NOWHERE ELSE - one id per physical robot. Empty = filled from the token.
EMORI_ROBOT_ID=
# Display name (dashboard header, reports, the drop-in learner's name). Empty = the display
# name Pokamind issued with the token, else the default (the same as EMORI_ROBOT_NAME=EMORI).
EMORI_ROBOT_NAME=

# ============ Live source (emori-run --source pokamind / the ROS publisher) ============
# Details: docs/configuration.md#live-source-emori-run---source-pokamind--the-ros-publisher
# The hostapp's /ws/relay — /api/cycle broadcasts every stamped envelope here.
POKAMIND_WS_URL=ws://localhost:8090/ws/relay

# ============ Hostapp: Pokamind partner SSO ============
# Details: docs/configuration.md#hostapp-pokamind-partner-sso
# Pokamind API origin (deploy_to_robot.py asks for it; empty = https://api.pokamind.com).
# The admin page can change it (Settings > Server, PIN again) only after a check with this
# robot's token against the new origin.
POKAMIND_BASE=https://api.pokamind.com
# The SSO course claim for drop-ins and for badges whose roster has no course_id.
# Empty = the course issued with this robot's token, else 'emori'.
EMORI_COURSE_ID=
# Session language: ca | en. Empty = this robot's default language in Pokamind (else its
# first supported language, else en). BOOT DEFAULT only: the idle language toggle
# persists to EMORI_LANG_STATE_FILE, which outranks this value on later boots.
EMORI_LANG=
#EMORI_LANG_STATE_FILE=artifacts/kiosk_lang.json
# 1 = synthesize a demo session instead of embedding a real Pokamind session
# (always, whatever this says, while the robot has no Pokamind token)
HOSTAPP_DEMO=
HOSTAPP_HOST=0.0.0.0
HOSTAPP_PORT=8090

# ============ Hostapp: kiosk behaviour ============
# Details: docs/configuration.md#hostapp-kiosk-behaviour
# Staff roster (QR badge -> identity) and the verbal topic menu:
EMORI_ROSTER=configs/roster.yaml
# Allowlist of the EXACT module-category strings this site serves (comma-separated). An
# unlisted roster pathway is dropped with a WARNING. Empty = this robot's pathways in
# Pokamind (none derived when one holds a comma; with none, forward whatever the roster
# says). * = no allowlist, explicitly.
EMORI_PATHWAYS=
# --- the spoken topic menu: where it comes from ---------------------------------------
# First match wins: EMORI_VOICE_TOPICS_<LANG> (below) > configs/site/voice_topics.<lang>.yaml
# (saved on the admin page's Menu tab) > configs/prod/ (forks that ship a fixed menu) > the
# menu built from this robot's Pokamind modules (configs/site/auto/) > the development menus.
# A deploy never ships or touches configs/site/. Set these only to pin a file of your own:
#EMORI_VOICE_TOPICS_CA=configs/site/voice_topics.ca.yaml
#EMORI_VOICE_TOPICS_EN=configs/site/voice_topics.en.yaml
# The old GLOBAL override (every language at once); prefer the per-language variables above.
#EMORI_VOICE_TOPICS=configs/voice_topics.yaml
# Behaviour + signal-translation tuning (BehaviorConfig/TranslationConfig):
EMORI_BEHAVIOR_CONFIG=configs/behavior.yaml
# Idle ticker: gentle alive-motion when no cycle arrives for N seconds (0 = off)
EMORI_IDLE_AFTER_S=8
# 1 = hold the body still while the learner has the floor (servo noise at the head's mic is as
# loud as a learner at 80 cm). 0 = the old attentive breath while listening.
EMORI_LISTEN_STILL=1
# Screenless verbal menu: constrained Vosk grammar + confidence gate (EMORI_MENU_CONF_MIN).
# 0 = field kill switch back to open recognition, for a Vosk lexicon without the menu words.
EMORI_MENU_GRAMMAR=1
# Starting value (clean speech scores 0.83-1.00); tune for your room.
EMORI_MENU_CONF_MIN=0.6
# Misses before the kiosk hands back to badge + number buttons (it never auto-starts a topic),
# and the listen window in ms.
EMORI_MENU_MAX_TRIES=3
EMORI_MENU_LISTEN_MS=12000
# Menu-mic end-of-speech flush: trailing silence (ms; 0 = edge off), speech needed before an
# edge, and the BACKSTOP interval that gets audio to Vosk in a room that never falls silent.
EMORI_MENU_EOS_SILENCE_MS=700
EMORI_MENU_EOS_MIN_VOICED_MS=250
EMORI_MENU_FLUSH_MS=3500
# Training turn watchdog: re-prompt timing and the silent / unseen /
# present ceilings, in seconds. Read the details before changing any of them.
EMORI_TURN_REPROMPT_S=12
EMORI_TURN_FIRST_REPROMPT_S=20
EMORI_TURN_REPROMPT_EVERY_S=15
EMORI_TURN_MAX_REPROMPTS=2
EMORI_TURN_MAX_REPROMPTS_PER_TURN=3
EMORI_TURN_CEILING_S=35
EMORI_TURN_FIRST_CEILING_S=50
EMORI_TURN_ABS_CEILING_S=90
EMORI_TURN_PRESENT_CEILING_S=180
# Somebody seen but no longer answering: ends once the turn has run this long (never before
# the turn's silent ceiling) and nothing has been heard for the second value. 0 = off.
EMORI_TURN_PRESENT_SILENCE_S=45
EMORI_TURN_PRESENT_QUIET_S=10
# An ARMED turn whose endpointer never opens (hung or failed load) ends after this long.
# 0 = ARMED never ends on its own.
EMORI_TURN_ARMED_CEILING_S=90
EMORI_TURN_BODY_WINDOW_S=30
EMORI_TURN_FACE_WINDOW_S=8
EMORI_TURN_SELF_NOISE_S=3
EMORI_TURN_REJECT_EXTENSIONS=3
# 1 = the iframe also SPEAKS the re-prompt in the session voice (needs a Pokamind web app
# that supports the reprompt command; an older one ignores it).
EMORI_REPROMPT_SPOKEN=0
EMORI_WALKAWAY_S=45
# Grace for Pokamind to answer a robot-initiated end WITH its analysis before the local
# fallback finalizes: _S if nothing was exchanged, _TALKED_S once something was.
EMORI_END_GRACE_S=12
EMORI_END_GRACE_TALKED_S=150
# A completion arriving within this many seconds after the local finalize is salvaged onto
# the closed row (results kept). 0 = never salvage.
EMORI_LATE_COMPLETION_S=300
# Session-start deadline: _MS is the /session page's own timer, _S the adapter-side backstop.
# Neither fires once a cycle has arrived. 0 = off. Empty = the hardware profile's (120000 / 130
# on a Reachy Mini Wireless, whose CM4 loads the session page slowly), else 45000 / 45.
EMORI_SESSION_START_MS=
EMORI_SESSION_START_S=
# Presence walk-away: end WITH analysis after N s with no body in the camera analysis (camera
# evidence arms it). DEFAULT 0 = off; suggested start 20, then tune for your room.
EMORI_ABSENCE_S=0
# --- Turn-taking tuning passed to the embedded session page ---
# JSON merged over the session page's endpointer defaults, keyed by en|ca. Empty = the hardware
# profile's on a Reachy Mini Wireless, else inert. Example: {"ca":{"hysteresis":{"pos":0.62}}}
EMORI_TT_OVERRIDES=
# 1 enables POST /api/tt-overrides to retune a RUNNING kiosk over the LAN. Default 0: a shipped
# robot is not remotely reconfigurable. GET is always allowed.
EMORI_TT_INJECT_HTTP=0
# Extra postMessage targetOrigins for that patch (POKAMIND_BASE is always included); add the
# session page's origin when it differs from POKAMIND_BASE. Never '*'.
EMORI_TT_TARGET_ORIGINS=
# Record every stamped envelope to artifacts/recordings/<session>.jsonl (0 = off)
EMORI_RECORD=1
# Where the last completion payload is persisted:
EMORI_RESULTS_FILE=artifacts/last_results.json

# ============ Optional add-ons ============
# Details: docs/configuration.md#optional-add-ons
# Separately installed packages that publish an emori_adapter.extensions entry point are
# loaded at start (docs/addons.md). 'off' skips discovery: the kiosk then runs without any.
# Their own settings are documented with the add-on, not here.
#EMORI_ADDONS=

# ============ Hostapp: server-side speech (scripts/get_voice_models.*) ============
# Details: docs/configuration.md#hostapp-server-side-speech-scriptsget_voice_models
# Defaults: voices/{ca,en}.onnx and models/vosk-{ca,en}. ca, en = the session languages.
# A voice of another language: voices/<lang>.onnx, or PIPER_VOICE_<LANG>.
PIPER_VOICE_CA=
PIPER_VOICE_EN=
VOSK_MODEL_CA=
VOSK_MODEL_EN=
# Menu-mic frame-energy gate: RMS floor (dBFS) and voiced ms per window. A bad floor may skip
# windows but never the FIRST window after the mic opens; bypasses count in window.__emoriGateBypass.
EMORI_STT_ENERGY_DBFS=-50
EMORI_STT_MIN_VOICED_MS=120

# ============ Results email (unset SMTP host = drop to artifacts/outbox/) ============
# Details: docs/configuration.md#results-email-unset-smtp-host--drop-to-artifactsoutbox
# Optional: Pokamind e-mails the session results itself, so most sites leave SMTP empty.
# Only for the robot's own engagement report. The admin page (Settings > Results e-mail)
# sets these, with a test send; the password there is write-only.
EMORI_SMTP_HOST=
EMORI_SMTP_PORT=587
EMORI_SMTP_USER=
EMORI_SMTP_PASS=
# Required when EMORI_SMTP_HOST is set (or an EMORI_SMTP_USER that is an e-mail address);
# without one the report goes to artifacts/outbox/ and readycheck warns.
EMORI_SMTP_FROM=
# The server's TLS certificate is checked (STARTTLS; port 465 = TLS from the start).
# 0 = do not check: only for a self-signed server on a network you trust.
#EMORI_SMTP_TLS_VERIFY=1
# Trainer/team inbox(es), comma-separated; roster emails are added automatically:
EMORI_RESULTS_TO=

# ============ FIWARE / NGSI-LD ============
# Details: docs/configuration.md#fiware--ngsi-ld
# 0 (shipped) disables FIWARE on the hostapp live path entirely; the on-robot dashboard
# works without it. 1 + the endpoints below (or the admin page's Settings > Analytics).
EMORI_FIWARE=0
ORION_URL=http://localhost:1026
NGSILD_TENANT=pokamind
# Where Orion notifies QuantumLeap (resolvable from ORION's network, not ours):
QL_NOTIFY_URL=http://quantumleap:8668/v2/notify
# Safe with NO broker present: the hostapp probes Orion once per session and degrades to a
# no-op writer (a fiware_skipped event for the dashboard).

# ============ Management dashboard (on-robot, port 8090) ============
# Details: docs/configuration.md#management-dashboard-on-robot-port-8090
# http://<robot>:8090/dashboard from a phone on the LAN: a local SQLite mirror of the
# per-cycle metrics, so it works with no Orion-LD.
EMORI_DASH_DB=artifacts/dashboard.db
# HMAC key for the pseudonymous person codes: set ONCE per robot (rotating it makes every
# returning learner new). Unset = derived from EMORI_ROBOT_ID. install.sh generates it on a
# robot whose dashboard has no data yet.
EMORI_DASH_SALT=
# Shared management password; empty = the dashboard refuses to serve. Logins are rate-limited;
# changing it (or the salt) signs every session out. install.sh generates it when empty and
# shows it once, at the end of the install.
EMORI_DASH_PASSWORD=
# Uptime evidence cadence, seconds (0 disables). The header shows EMORI_ROBOT_NAME: set it
# once at the top, never again here (the last assignment wins).
EMORI_HEARTBEAT_S=60

# ============ Superadmin service (on-robot, port 8070; phone-first ops) ============
# Details: docs/configuration.md#superadmin-service-on-robot-port-8070-phone-first-ops
# The :8070 phone admin (docs/robot-admin.md). 6-digit PIN for the whole surface. Empty =
# install.sh generates one and shows it once, at the end of the install; change it on the
# admin page (Settings > Credentials). With no PIN at all every /api/* route answers 503.
EMORI_ADMIN_PIN=
# 0.0.0.0 so it answers on the site LAN AND on the robot's own AP (10.42.0.1).
EMORI_ADMIN_PORT=8070
EMORI_ADMIN_HOST=0.0.0.0
# High-entropy HMAC salt for the admin cookie (a guessable one turns a captured cookie into a
# PIN cracker). install.sh generates one; changing it signs every admin session out.
EMORI_ADMIN_SALT=
# Machine secret between emori-admin and the hostapp's /api/admin/* routes; install.sh
# generates it. Missing on either side = those routes answer 503.
EMORI_ADMIN_TOKEN=
# Where emori-admin persists operator-set audio levels, so a reboot re-applies them.
EMORI_ADMIN_STATE_FILE=artifacts/admin_state.json
# Your own hotspot SSID/password (>= 8 chars), applied at emori-admin start. REQUIRED for the
# Wi-Fi watchdog below, which refuses to raise the vendor's well-known AP unattended.
EMORI_AP_SSID=
EMORI_AP_PASSWORD=
# Raise the hotspot after GRACE_S seconds of Wi-Fi 'disconnected' (the Wi-Fi backend's own
# setup_hotspot). Arms only with EMORI_AP_SSID + EMORI_AP_PASSWORD set; 0 disables.
EMORI_ADMIN_WIFI_WATCHDOG=1
EMORI_ADMIN_WIFI_GRACE_S=180
# Who does Wi-Fi + speaker/mic volume: auto | daemon (Pollen's :8000 API, v1) | host
# (emori-admin itself: nmcli + amixer, for v2 where the ROS node owns :8000). auto = host when
# :8000 is the v2 shim, answers 404 on /wifi or /api/volume, or is silent with the v2 fence up.
EMORI_ADMIN_HOST_BACKEND=auto

# ============ Badge, head-gesture and language-toggle UX ============
# Details: docs/configuration.md#badge-head-gesture-and-language-toggle-ux
# Physical greeting at a successful badge scan, off by default
# (auto-suppressed while an add-on mode is active).
EMORI_SCAN_GREETING=0

# Per-mode wpctl capture-gain MULTIPLIERS (not device selectors), clamped 0..4.0; the admin
# Audio tab can override them live. Leave unset to keep the measured defaults.
#EMORI_MIC_SESSION_VOL=1.4
#EMORI_MIC_IDLE_VOL=0.30
# Shut the microphone to sound from the side and when nobody is in front of the robot, while a
# mode holds it: off, observe (decide and log, touch nothing) or on. Every doubt leaves it open.
# It cannot part two people speaking from the same direction.
#EMORI_MIC_GATE=off
#EMORI_MIC_GATE_HALF_WIDTH_DEG=50
#EMORI_MIC_GATE_FACE_HOLD_S=8
#EMORI_MIC_GATE_CLOSE_AFTER_S=0.3
#EMORI_MIC_GATE_REOPEN_AFTER_S=1.5

# Head-turn detection thresholds; tune only after calibrating on the robot.
EMORI_DIRECTIONAL_YAW_THRESHOLD_RAD=0.20
EMORI_DIRECTIONAL_ROLL_THRESHOLD_RAD=0.20
EMORI_DIRECTIONAL_AMBIGUITY_RATIO=1.40

# Spoken cue for unregistered badges, off by default. Enabling it REVEALS roster membership to
# whoever scans a badge, so enable it only where that disclosure is acceptable.
EMORI_UNREGISTERED_BADGE_FEEDBACK=0
EMORI_UNREGISTERED_BADGE_CUE_WAV=
EMORI_UNREGISTERED_BADGE_CUE_SHA256=

# QR scan-to-/session lease deadline (seconds, 10-600; default 60). Raise it if Piper TTS +
# Vosk retries + Pokamind SSO take longer than 60 s on your robot.
#EMORI_TRAINING_NAV_TIMEOUT_S=60

# Idle head-tilt 'begin', off by default, for robots WITHOUT an add-on that reads the same
# head turns: never set it together with such an add-on.
EMORI_GESTURE_BEGIN=0

# Head gestures: 0 disables them (REQUIRED on the MuJoCo sim). push_turn is REQUIRED on daemon
# v1.9.0 (gravity_compensation answers HTTP 500); back_drive is the firmware-default mode.
EMORI_GESTURE=1
EMORI_GESTURE_MODE=push_turn
# REQUIRED WITH push_turn on this firmware: a turn the operator calls LEFT reads as RIGHT
# (d_roll=+0.236). readycheck fails the gesture gate without it.
EMORI_GESTURE_INVERT=1
# Guards against self-selection while the head settles (ticks are 10 Hz). Raise the ticks if
# the robot self-selects; raise the epsilons only if real turns are missed.
#EMORI_GESTURE_SETTLE_EPSILON_RAD=0.03
#EMORI_GESTURE_SETTLE_TICKS=3
#EMORI_GESTURE_QUIET_EPSILON_RAD=0.05
#EMORI_GESTURE_QUIET_TICKS=3
# A firm push of the head BACK, held a little over half a second, leaves whatever is running: it works
# in a session and in an add-on mode, while the robot is moving too. 0 is THE ROLLBACK and
# takes a restart. The threshold is the residual pitch in radians, the hold is in 10 Hz ticks.
#EMORI_GESTURE_BACK_EXIT=1
#EMORI_GESTURE_BACK_THRESHOLD_RAD=0.15
#EMORI_GESTURE_BACK_HOLD_TICKS=7
# Per-tick head-pose trace. OFF on a deployed robot: it logs at WARNING, ~400 lines a day, on
# an SD card that can already be 94% full. On for one debugging session, then off.
EMORI_GESTURE_DEBUG=0
# Residual sensing (v2): push_turn reads measured - commanded. THE ROLLBACK: 0 + a restart
# reverts three things together: per-sentence cues, the skill intake's 423, the idle scan.
#EMORI_GESTURE_RESIDUAL=1

# Hidden idle EN/CA toggle (a head turn one way, then the other, inside the window). Shipped 0:
# while armed, every lone head turn waits out the window before an add-on acts on it.
EMORI_LANG_TOGGLE=0
#EMORI_LANG_TOGGLE_WINDOW_S=2.5
# pw-play --target for the robot's own spoken confirmation (empty = the default sink).
#EMORI_PLAY_TARGET=

# ============ Per-sentence expression cues (behavior/cues.py) ============
# Details: docs/configuration.md#per-sentence-expression-cues-behaviorcuespy
# Plan a bounded motion per AI sentence from its cue family; all cue knobs are read once at
# hostapp start. 0 is a true kill-switch back to the pre-cue talking_gesture.
#EMORI_CUE_MOTION=1
# Hard cap on one sentence's motion budget, seconds.
#EMORI_CUE_MAX_S=4.0
# Clamp on head Z travel (mm, max 20). 18 measured on a Reachy Mini Wireless (its
# hardware profile); 8.0 elsewhere, deliberately timid: bisect on any other robot.
#EMORI_CUE_Z_MM=8.0
# Body-yaw terms in the cue recipes. On (1) as measured on a Reachy Mini Wireless
# (its hardware profile); off elsewhere until measured on that robot.
#EMORI_CUE_BODY_YAW=0
# Escalation above which every family maps to softening at quarter intensity (never back).
#EMORI_CUE_DEESCALATE_AT=0.6
# Amplitude multiplier over cue and talking motion (0.5..2.0; the total is capped at 1.6).
# Unset = 1.6 on a Reachy Mini Wireless (hardware profile), else 1.0.
#EMORI_CUE_AMP=1.0
# Untagged sentences perform the full-DOF talking flow; 0 restores the older antenna flick.
#EMORI_CUE_TALK=1
# The turn's family colours its untagged sentences at reduced amplitude; 0 = neutral flow.
#EMORI_CUE_CARRY=1

# Per-sentence timing of the motion path, written to artifacts/motion-trace/ for
# scripts/motion_sync_report.py. Ids, times and families only, never a sentence's words.
EMORI_MOTION_TRACE=1
# 0 puts back the older motion timing: beats released before the last one has finished, moves
# that wait behind earlier ones, and the voice bound from when the player reaches a sentence.
#EMORI_MOTION_SYNC=1
# Milliseconds the kiosk's voice is held back, so the head, which takes longer to answer than
# the voice takes to reach the speaker, moves with the word instead of after it. It also
# reaches the room later than the page thinks. Needs emori-voice-delay.service restarted, then
# the hub and the kiosk. 0 turns it off.
EMORI_VOICE_DELAY_MS=100

# ============ ROS skill intake (POST /api/skill) ============
# Details: docs/configuration.md#ros-skill-intake-post-apiskill
# The ROS graph's ONLY way to move the robot, through the same RobotPlayer queue.
# Off by default: no flag, no route.
#EMORI_SKILL_API=0
# Shared secret (X-Emori-Skill-Key); the route refuses to mount without it. Per robot; never commit.
#EMORI_SKILL_KEY=
# One ACCEPTED request per this many seconds; the excess is refused (429), never queued.
#EMORI_SKILL_MIN_INTERVAL_S=0.35
# Read in the ROS container by emori_skill_facade: hostapp_http (default, POST /api/skill) |
# log (records, posts nothing: bench and standalone smoke) | ros_native (v2 robot node).
#EMORI_SKILL_TRANSPORT=hostapp_http
# Which lane submits motion: hostapp (default) | ros (motion originates in the ROS graph) | none.
# Enforced on both sides; an unknown value reads as hostapp. Read once at hostapp start.
#EMORI_ROS_MOTION_OWNER=hostapp
# owner=ros dead-man's handle: after N s with no accepted skill the hostapp takes its lanes
# back. OFF (0) so a wedged graph fails visibly; consider it for an unattended venue.
#EMORI_ROS_OWNER_FALLBACK_S=0
# --- read inside the ROS 2 CONTAINER, not by the hostapp -----------------------------
# These four belong in deploy/ros2/.env, beside the motor's compose file, and stay there with
# EMORI_HUB_GRAPH=1: the hub reads them from that file, and ignores them here with a warning.
# Host file bind-mounted read-only over the container's /emori/configs/behavior.yaml.
#EMORI_ROS_BEHAVIOR_CONFIG_HOST=/opt/emori/configs/behavior.yaml
# What leaves the graph on DDS: pseudonymous ids, no spoken text, a per-process salt. A fixed
# salt is a re-identification key - treat it as a secret.
#EMORI_ROS_DEIDENTIFY=1
#EMORI_ROS_SPEECH_TEXT=0
#EMORI_ROS_ID_SALT=
# The hub's session-event topic carries typed, gated fields only. 1 adds the relayed envelope
# itself as JSON in SessionEvent.payload_json, through the same gate: ids replaced, and the
# spoken text, the cue direction and the learner's transcript removed unless
# EMORI_ROS_SPEECH_TEXT=1. Its results, scores included, then travel. Only a spelled-out yes
# turns it on. Read from this file, unlike the three above.
#EMORI_ROS_RAW_ENVELOPES=0
# 0 hosts no facade node in the hub, so it is the host app over ROS and nothing else on the
# graph: no /emori/session, /emori/speech, /emori/gesture, /emori/motion, /emori/gateway or
# /emori/addon. Takes a restart of the hub.
#EMORI_HUB_FACADES=1
# 1 lets /emori/gesture/inject_turn hand the add-on's head-turn hook a signed turn, as if the head
# had made it. Off by default: a graph member could otherwise select a mode. Only a spelled-out
# yes turns it on. Refused while a training session runs.
#EMORI_HUB_GESTURE_INJECT=0
# --- v2 face look-at (the robot node's own camera; read inside the container) --------
# Capability switch, Fail-closed: the detector runs only when the hostapp asks, in a session.
# Publishes a box + confidence only: no image, crop, embedding or identity is stored.
#EMORI_GAZE=1
# Detections per second (the robot compose default 3.0; launch default 5.0). The CM4 measured
# 71 ms per frame, so 3.0 is what keeps /joint_states above 45 Hz on a robot running the kiosk.
#EMORI_GAZE_DETECT_HZ=5.0
# These reach the node via deploy/ros2/.env (substituted by the robot compose file), NOT from
# this file. Follower loop rate; 0 = one write per detection.
#EMORI_GAZE_SERVO_HZ=25.0
# 1 = speech gotos and streamed targets are composed onto the face aim while gaze holds
# a face (a person to one side otherwise gets a robot talking to the wall). 0 = off.
#EMORI_GAZE_ANCHOR=1
# Empty = derived from EMORI_ROS_MOTION_OWNER (interaction while the hostapp owns
# expression, where an expression-lane gaze write is refused not_owner); a value wins.
#EMORI_GAZE_LANE=
# How much face aim a Pollen recorded move gets: yaw (default; with pitch too, 16% of its
# frames are out of reach) | full | off.
#EMORI_GAZE_ANCHOR_RECORDED=yaw
# Seconds over which a recorded move eases in from where the head is commanded to be,
# instead of snapping onto its first frame (up to 46 deg measured). 0 = snap.
#EMORI_RECORDED_BLEND_S=0.3
# 0 plays a recorded move from its first frame, including the stillness some of them open
# with, instead of from just before its first motion.
#EMORI_RECORDED_SKIP_LEADIN=1
# The file the motor container binds, so that it cannot start once the fence is down. /dev/null
# is for a trial by hand, with no fence (deploy/robot/ros2_native/README.md). Compose reads this
# from the shell or from deploy/ros2/.env.
#EMORI_V2_FENCE_FILE=/opt/emori/V2_OWNS_THE_BUS
# 0 sends a recorded move's head to the motors as authored. Pollen's IK refuses a target it cannot
# reach and the head then stands still, and a servo does not follow a goal past its limit; 1 draws
# the head's translation in until the motors can reach it, and keeps the rotation that makes the
# gesture.
#EMORI_RECORDED_FIT=1
# The BAKED model path inside the image. To try another model without a rebuild, scp it to
# /opt/emori/models and point this at /opt/emori/models-host/<file>.
#EMORI_GAZE_MODEL=/opt/emori/models/face_detection_yunet_2026may.onnx
# Where that read-only host copy comes from; compose mounts it at /opt/emori/models-host.
#EMORI_MODELS_HOST=/opt/emori/models
# --- the camera bridge's ROS tee (read by deploy/robot/camera-bridge.sh) -------------
# The bridge reads these from /etc/default/emori-camera, NOT this file; emptying
# EMORI_CAM_ROS_VIDEO_NR (then restarting emori-camera-bridge) is the camera rollback:
#   EMORI_CAM_ROS_VIDEO_NR=41   the second v4l2loopback node; EMPTY = no tee at all
#   EMORI_CAM_ROS_WIDTH=320 / _HEIGHT=240 / _FPS=10   what the tee branch produces
# Opt-in for the containerised ROS 2 graph (install.sh step 11, an arm64 image built off the robot).
# A v2 robot needs no line: readycheck checks its container whenever the v2 fence is up.
#EMORI_WITH_ROS2=0
# The ROS 2 stack every deploy leaves this robot on (deploy/robot/ros2_native/v2-stack.sh):
# v2 (default) = the robot is a ROS 2 node, Pollen's daemon fenced off the motor bus;
# v1 = Pollen's daemon owns it (Pollen's apps, SDK and dashboard need v1).
# Deploy-to-Robot --v1 / --v2 writes this line.
#EMORI_ROS2_STACK=v2

# ============ Hub (the hostapp hosted on the ROS 2 graph) ============
# Details: docs/configuration.md#hub-the-hostapp-hosted-on-the-ros-2-graph
# How the hub reaches the robot: ros (default) = the robot node's services; http = the REST
# routes at REACHY_BASE_URL. The hostapp's own entry point always uses REST and ignores this.
#EMORI_ROBOT_TRANSPORT=ros
# 1 opens /emori/motion/submit_batch, which hands a batch of moves to the motion player. It is
# refused while a training session is open whatever this says. Only a spelled-out yes (1, true,
# yes, on) turns it on.
#EMORI_HUB_MOTION_SUBMIT=0
# 1 runs the graph's four nodes in the hub, and goes with EMORI_MOTOR_LAUNCH=robot.launch.py.
# 0 leaves them in the motor container. deploy/robot/hub-stack.sh --with-motor sets both.
#EMORI_HUB_GRAPH=0
# In deploy/ros2/.env, not here: the launch file the motor container runs. v2.launch.py (the
# robot node and the graph) or robot.launch.py (the robot node alone). Changing it recreates
# the container, which parks and wakes the robot.
#EMORI_MOTOR_LAUNCH=v2.launch.py

# ============ Readiness self-check (emori-readycheck; read-only) ============
# Details: docs/configuration.md#readiness-self-check-emori-readycheck-read-only
# Both default to the deployed values, so leaving them unset changes nothing.
# Override only when checking a stack that is not on this box's defaults.
#EMORI_READYCHECK_HOSTAPP_URL=http://127.0.0.1:8090
#EMORI_READYCHECK_VIDEO_DEVICE=/dev/video40
# The v2 face look-at tee, for readycheck's gaze gate. Unset = the device EMORI_CAM_ROS_VIDEO_NR
# arms in /etc/default/emori-camera (no tee there = PASS gaze_lane_off); a value here wins.
#EMORI_READYCHECK_ROS_VIDEO_DEVICE=/dev/video41

# ============ Robot-local settings layer ============
# Details: docs/configuration.md#robot-local-settings-layer
# What this robot is. install.sh writes reachy-mini-wireless; it supplies the tuning measured
# on that robot (session start, cues, turn-taking) when it is empty, and marks an installed
# robot. Empty on a dev box.
EMORI_HARDWARE_PROFILE=
# 1 = settings left empty here are filled from this robot's Pokamind record (course,
# languages, pathways, name) and its menu is built from its Pokamind modules.
# 0 = switch all of that off (the menu then falls back to configs/site, prod, dev, built-in).
EMORI_SITE_AUTO=1
# Seconds of continuous idle (no session, no add-on mode) before emori-admin restarts the
# host app by itself to apply a change from Pokamind or a regenerated dashboard password; at
# most once per 30 min. 0 = never by itself (the Settings tab's Apply now still works).
#EMORI_SITE_AUTO_APPLY_IDLE_S=600

# ============ THIS robot's Pokamind token (per robot) ============
# Details: docs/configuration.md#this-robots-pokamind-token-per-robot
# Every robot has its OWN Pokamind credential: a per-robot Ed25519 token that only Pokamind
# issues for this one robot, and that the robot uses to sign its learner logins and its
# control-plane calls. It is ONE line:
#     pkr1.<robot-id>.<key>
# Pokamind keeps only the public half, scoped to one org, one course, its languages and
# its module list -- so this robot can open exactly those sessions and nothing else.
#
# It lives in a FILE, not in this .env: /opt/emori/secrets/pokamind_robot_token
# (directory 0700, file 0600, owner pollen). Deploy-to-Robot asks for it and installs it
# there over SSH; the admin page's Pokamind tab (:8070) tests it, replaces it (the kiosk
# restarts) and -- after the PIN is typed again -- reveals it for 30 seconds.
# Its Pokamind identity is the token's robot_id, and
# Deploy-to-Robot fills an empty EMORI_ROBOT_ID from it. Keep that line once the robot is
# in use: the dashboard's person codes (while EMORI_DASH_SALT is empty) and the admin
# page's robot name derive from it. Set to a DIFFERENT robot it is logged as an ERROR and
# readycheck fails robot_id_mismatch (the token still wins).
# The token also brings this robot's scope: its course, languages, pathways and menu follow
# its Pokamind record (synced at start, every 6 h and from the admin page) unless set above.
# One token = one robot: never put it in robot.local.env or any file reused for the next
# robot. Issue / install / replace / revoke, step by step: docs/deploy-a-new-robot.md
#
# Where the token file lives, relative to /opt/emori. Leave it unset.
#EMORI_POKAMIND_TOKEN_FILE=secrets/pokamind_robot_token
# DEV AND TESTS ONLY: the token itself, read only when the token file is absent or empty.
# On a robot use the file -- an .env gets copied around far too easily.
#POKAMIND_ROBOT_TOKEN=
